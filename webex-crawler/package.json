{
  "name": "webex-crawler",
  "version": "1.0.0",
  "description": "Sitemap-driven crawler for help.webex.com — converts Webex documentation to markdown",
  "type": "module",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "crawl": "bun run scripts/crawl-webex.ts -o ../webex-docs",
    "crawl:dry-run": "bun run scripts/crawl-webex.ts -o ../webex-docs --dry-run",
    "crawl:verbose": "bun run scripts/crawl-webex.ts -o ../webex-docs --verbose"
  },
  "dependencies": {
    "node-html-markdown": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
